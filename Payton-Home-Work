class Shaxs:
    odamlar_soni = 0

    def __init__(self, ism, yosh):
        self.__ism = ism
        self.__yosh = yosh
        Shaxs.odamlar_soni += 1

    def get_ism(self):
        return self.__ism

    def set_ism(self, ism):
        self.__ism = ism

    def get_yosh(self):
        return self.__yosh

    def set_yosh(self, yosh):
        self.__yosh = yosh

    @classmethod
    def get_odamlar_soni(cls):
        return cls.odamlar_soni


class Talaba(Shaxs):
    talabalar_soni = 0

    def __init__(self, ism, yosh, kurs):
        super().__init__(ism, yosh)
        self.__kurs = kurs
        Talaba.talabalar_soni += 1

    def get_kurs(self):
        return self.__kurs

    def set_kurs(self, kurs):
        self.__kurs = kurs

    @classmethod
    def get_talabalar_soni(cls):
        return cls.talabalar_soni


